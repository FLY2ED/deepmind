# ============================================================================
# 방법 A: Google AI Studio API 키 사용 (가장 빠르고 간편한 방법)
# 발급처: https://aistudio.google.com/app/apikey
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# 방법 B: API 키 없이 GCP (Vertex AI / ADC) 프로젝트 직접 연동
# 로컬에서 `gcloud auth application-default login` 실행 후 아래 주석 해제
# (Cloud Run 배포 시에는 서비스 계정으로 자동 인증됨)
# ============================================================================
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ============================================================================
# Server Configuration (Tailscale IP 100.87.196.95 포함 전체 인터페이스 바인딩)
# ============================================================================
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
